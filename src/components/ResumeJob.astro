---
interface Props {
  job: { company: string; role: string; period: string; stack?: string; bullets: string[] };
  showCompany?: boolean;
  stackLabel: string;
}
const { job, showCompany = false, stackLabel } = Astro.props;
---
<article class="resume-job">
  {showCompany && <h3>{job.company}</h3>}
  <p class="job-role">{job.role}</p>
  <p class="job-period">{job.period}</p>
  <ul class="job-achievements">{job.bullets.map(item => <li>{item}</li>)}</ul>
  {job.stack && <p class="job-stack" aria-label={stackLabel}>{job.stack}</p>}
</article>
